{
    "logging_config": {
        "save_path": "./results/addition-max_int_64-no_eos",
        "experiment_name": "supervised-roformer-scratch-8-stop_on_empty",
        "log_interval": 50,
        "checkpoint_interval": 100000,
        "validation_interval": 500
    },
    "model_config": {
        "architecture": "InContextRoformer",
        "model_kwargs": {
            "num_blocks": 4,
            "num_heads": 8,
