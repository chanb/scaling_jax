        "right_to_left": true,
        "shuffle": true,
        "predict_eos": false,
        "num_cot_tokens": 2
    },
    "repeat": false,
    "shuffle_buffer_size": 100,
    "num_workers": 1,
    "batch_size": 2,
    "train_loss_config": {
        "objective": "ce",
        "mdp_type": "episodic:length_bias_fix"
